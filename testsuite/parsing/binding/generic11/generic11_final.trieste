infix
resolve_types
(top
  {
    Container = module
    IntModule = module
    Test = module
    Wrapper = module}
  (file
    (module
      {
        Int = struct}
      (name 9:IntModule)
      (type_params)
      (body
        (indent
          (struct
            {}
            (name 3:Int)
            (type_params)
            (fields)))))
    (module
      {
        Inner = type_alias
        T = type_param}
      (name 7:Wrapper)
      (type_params
        (type_param
          (name 1:T)))
      (body
        (indent
          (type_alias
            {}
            (name 5:Inner)
            (type_params)
            (type
              (type_lookup
                (../)
                (type_reference
                  (name 1:T)
                  (type_args))))))))
    (module
      {
        T = type_param
        Wrapped = type_alias}
      (name 9:Container)
      (type_params
        (type_param
          (name 1:T)))
      (body
        (indent
          (type_alias
            {}
            (name 7:Wrapped)
            (type_params)
            (type
              (type_lookup
                (../)
                (../)
                (type_reference
                  (name 7:Wrapper)
                  (type_args
                    (type
                      (type_lookup
                        (../)
                        (type_reference
                          (name 1:T)
                          (type_args))))))))))))
    (module
      {
        include use Container[IntModule]::Wrapped::Inner
        include use Int}
      (name 4:Test)
      (type_params)
      (body
        (indent
          (use
            (type
              (type_lookup
                (../)
                (type_reference
                  (name 9:IntModule)
                  (type_args)))))
          (use
            (type
              (type_lookup
                (../)
                (type_reference
                  (name 9:IntModule)
                  (type_args))
                (type_reference
                  (name 3:Int)
                  (type_args))))))))))
