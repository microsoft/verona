infix
parse_types
(top
  {
    BoolModule = module
    Box = module
    IntModule = module
    Test = module}
  (file
    (module
      {
        Int = struct}
      (name 9:IntModule)
      (type_params)
      (body
        (indent
          (struct
            {}
            (name 3:Int)
            (type_params)
            (fields)))))
    (module
      {
        Bool = struct}
      (name 10:BoolModule)
      (type_params)
      (body
        (indent
          (struct
            {}
            (name 4:Bool)
            (type_params)
            (fields)))))
    (module
      {
        Contents = type_alias
        T = type_param}
      (name 3:Box)
      (type_params
        (type_param
          (name 1:T)))
      (body
        (indent
          (type_alias
            {}
            (name 8:Contents)
            (type_params)
            (type
              (type_lookup
                (type_reference
                  (name 1:T)
                  (type_args))))))))
    (module
      {
        include use Box[IntModule]::Contents
        include use Box[BoolModule]::Contents
        include use Int
        include use Bool}
      (name 4:Test)
      (type_params)
      (body
        (indent
          (use
            (type
              (type_lookup
                (type_reference
                  (name 3:Box)
                  (type_args
                    (type
                      (type_lookup
                        (type_reference
                          (name 9:IntModule)
                          (type_args))))))
                (type_reference
                  (name 8:Contents)
                  (type_args)))))
          (use
            (type
              (type_lookup
                (type_reference
                  (name 3:Box)
                  (type_args
                    (type
                      (type_lookup
                        (type_reference
                          (name 10:BoolModule)
                          (type_args))))))
                (type_reference
                  (name 8:Contents)
                  (type_args)))))
          (use
            (type
              (type_lookup
                (type_reference
                  (name 3:Int)
                  (type_args)))))
          (use
            (type
              (type_lookup
                (type_reference
                  (name 4:Bool)
                  (type_args))))))))))
