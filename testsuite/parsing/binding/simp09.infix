# Mutual use between modules creates a deadlock.
# In module A, resolving `use C` blocks on the preceding `use B::T1`,
# which transitively depends on `use A::T2` in module B, which blocks
# on the preceding `use C` in B, creating a circular dependency.
# Reordering `use C` before the cross-module use would break the cycle
# (see mutual_use01.infix).
module C
  module Foo
    module Bar

module A
  use B::T1
  use C
  type T2 = Foo
  type T4 = Bar

module B
  use A::T2
  use C
  type T1 = Foo
  type T3 = Bar
