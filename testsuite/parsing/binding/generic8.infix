# Lookup on TypeParams with where clause (not yet supported)
# This example is supporting lookup on TypeParams.
# This is not currently supported.
# Revisit this example when that feature is implemented.

module Module1[T1] where T1::Bar: Type
  type Foo = T1::Bar
  type Bar = T1

module Module3
  struct Int

module Test
  # This brings Int into scope.
  use Module1[Module1[Module3]::Foo]::Bar
  ##  Reduces to
  ##  Module1[Module3]::Foo
  ##  Reduces to
  ##  Module3
  ##  So Int is now in scope.
  ## There are two orders of evaluation here:
  ##  Reduces to
  ##  Module1[Module3]::Bar
  ##  Reduces to
  ##  Module3
  ## Interesting design on which makes most sense.
  ## Evaluating the argument first might not be needed, but
  ## If it is used more than once, then it would be less efficient.
  use Int