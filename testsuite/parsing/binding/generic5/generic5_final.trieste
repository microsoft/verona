infix
resolve_types
(top
  {
    Module1 = module
    Module2 = module
    Module3 = module
    Test = module}
  (file
    (module
      {
        Bar = type_alias
        T2 = type_param}
      (name 7:Module2)
      (type_params
        (type_param
          (name 2:T2)))
      (body
        (indent
          (type_alias
            {}
            (name 3:Bar)
            (type_params)
            (type
              (type_lookup
                (../)
                (type_reference
                  (name 2:T2)
                  (type_args))))))))
    (module
      {
        Foo = type_alias
        T1 = type_param
        include use Module2[T1}
      (name 7:Module1)
      (type_params
        (type_param
          (name 2:T1)))
      (body
        (indent
          (use
            (type
              (type_lookup
                (../)
                (type_reference
                  (name 7:Module2)
                  (type_args
                    (type
                      (type_lookup
                        (type_reference
                          (name 2:T1)
                          (type_args)))))))))
          (type_alias
            {}
            (name 3:Foo)
            (type_params)
            (type
              (type_lookup
                (../)
                (../)
                (type_reference
                  (name 7:Module2)
                  (type_args
                    (type
                      (type_lookup
                        (../)
                        (type_reference
                          (name 2:T1)
                          (type_args))))))
                (type_reference
                  (name 3:Bar)
                  (type_args))))))))
    (module
      {
        Int = struct}
      (name 7:Module3)
      (type_params)
      (body
        (indent
          (struct
            {}
            (name 3:Int)
            (type_params)
            (fields)))))
    (module
      {
        include use Module1[Module3]::Foo
        include use Int}
      (name 4:Test)
      (type_params)
      (body
        (indent
          (use
            (type
              (type_lookup
                (../)
                (type_reference
                  (name 7:Module3)
                  (type_args)))))
          (use
            (type
              (type_lookup
                (../)
                (type_reference
                  (name 7:Module3)
                  (type_args))
                (type_reference
                  (name 3:Int)
                  (type_args))))))))))
