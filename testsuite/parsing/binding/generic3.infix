# Nested generic modules with inner generic module
module Module1[T1]
  module Module2[T2]
    type Bar = T2
  type Foo = Module2[T1]

module Module3
  struct Int

module Test
  # This brings Int into scope.
  use Module1[Module3]::Foo::Bar
  ##  Reduces to 
  ##  Module1[Module3]::Module2[Module3]::Bar
  ##  Reduces to 
  ##  Module3
  ##  So Int is now in scope.

  use Int

