infix
parse_types
(top
  {
    Base = module
    Left = module
    Right = module
    Top = module}
  (file
    (module
      {
        SharedType = struct}
      (name 4:Base)
      (type_params)
      (body
        (indent
          (struct
            {}
            (name 10:SharedType)
            (type_params)
            (fields)))))
    (module
      {
        LeftAlias = type_alias
        include use Base}
      (name 4:Left)
      (type_params)
      (body
        (indent
          (use
            (type
              (type_lookup
                (type_reference
                  (name 4:Base)
                  (type_args)))))
          (type_alias
            {}
            (name 9:LeftAlias)
            (type_params)
            (type
              (type_lookup
                (type_reference
                  (name 10:SharedType)
                  (type_args))))))))
    (module
      {
        RightAlias = type_alias
        include use Base}
      (name 5:Right)
      (type_params)
      (body
        (indent
          (use
            (type
              (type_lookup
                (type_reference
                  (name 4:Base)
                  (type_args)))))
          (type_alias
            {}
            (name 10:RightAlias)
            (type_params)
            (type
              (type_lookup
                (type_reference
                  (name 10:SharedType)
                  (type_args))))))))
    (module
      {
        include use Left
        include use Right
        include use LeftAlias
        include use RightAlias
        include use SharedType}
      (name 3:Top)
      (type_params)
      (body
        (indent
          (use
            (type
              (type_lookup
                (type_reference
                  (name 4:Left)
                  (type_args)))))
          (use
            (type
              (type_lookup
                (type_reference
                  (name 5:Right)
                  (type_args)))))
          (use
            (type
              (type_lookup
                (type_reference
                  (name 9:LeftAlias)
                  (type_args)))))
          (use
            (type
              (type_lookup
                (type_reference
                  (name 10:RightAlias)
                  (type_args)))))
          (use
            (type
              (type_lookup
                (type_reference
                  (name 10:SharedType)
                  (type_args))))))))))
