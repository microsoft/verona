# Example of binding

module Module2
  module Module3
    struct Int

module Module1
  # After resolution this should be:
  #    type Foo = ..::Module2::Module3
  type Foo = Module2::Module3

module Test
  # This brings Int into scope.
  # After resolution this should be:
  #   use ..::Module2::Module3
  use Module1::Foo

  use Int