infix
parse_types
(top
  {
    Int = struct
    Module1 = module
    Module2 = module
    Test = module}
  (file
    (struct
      {}
      (name 3:Int)
      (type_params)
      (fields))
    (module
      {
        Module3 = module}
      (name 7:Module2)
      (type_params)
      (body
        (indent
          (module
            {
              inc = function}
            (name 7:Module3)
            (type_params)
            (body
              (indent
                (function
                  {
                    x = param}
                  (type_params)
                  (lhs
                    (param
                      (name 1:x)
                      (mode
                        (cbv))
                      (type
                        (type_lookup
                          (type_reference
                            (name 3:Int)
                            (type_args))))))
                  (name 3:inc)
                  (rhs)
                  (type
                    (type_lookup
                      (type_reference
                        (name 3:Int)
                        (type_args))))
                  (where)
                  (body
                    (expr_stack)
                    (name 1:x)
                    (name 3:inc)))))))))
    (module
      {
        Foo = type_alias
        include use Module2}
      (name 7:Module1)
      (type_params)
      (body
        (indent
          (use
            (type
              (type_lookup
                (type_reference
                  (name 7:Module2)
                  (type_args)))))
          (type_alias
            {}
            (name 3:Foo)
            (type_params)
            (type
              (type_lookup
                (type_reference
                  (name 7:Module3)
                  (type_args))))))))
    (module
      {
        test = function
        include use Module1::Foo}
      (name 4:Test)
      (type_params)
      (body
        (indent
          (use
            (type
              (type_lookup
                (type_reference
                  (name 7:Module1)
                  (type_args))
                (type_reference
                  (name 3:Foo)
                  (type_args)))))
          (function
            {
              x = param}
            (type_params)
            (lhs)
            (name 4:test)
            (rhs
              (param
                (name 1:x)
                (mode
                  (cbv))
                (type
                  (type_lookup
                    (type_reference
                      (name 3:Int)
                      (type_args))))))
            (type
              (type_lookup
                (type_reference
                  (name 3:Int)
                  (type_args))))
            (where)
            (body
              (expr_stack)
              (indent
                (group
                  (name 1:x)
                  (name 3:inc))))))))))
