infix
parse_types
(top
  {
    Module1 = module
    Module3 = module
    Test = module}
  (file
    (module
      {
        Foo = type_alias
        Module2 = module
        T1 = type_param}
      (name 7:Module1)
      (type_params
        (type_param
          (name 2:T1)))
      (body
        (indent
          (module
            {
              Bar = type_alias}
            (name 7:Module2)
            (type_params)
            (body
              (indent
                (type_alias
                  {}
                  (name 3:Bar)
                  (type_params)
                  (type
                    (type_lookup
                      (type_reference
                        (name 2:T1)
                        (type_args))))))))
          (type_alias
            {}
            (name 3:Foo)
            (type_params)
            (type
              (type_lookup
                (type_reference
                  (name 7:Module2)
                  (type_args))))))))
    (module
      {
        Int = struct}
      (name 7:Module3)
      (type_params)
      (body
        (indent
          (struct
            {}
            (name 3:Int)
            (type_params)
            (fields)))))
    (module
      {
        include use Module1[Module3]::Foo::Bar
        include use Int}
      (name 4:Test)
      (type_params)
      (body
        (indent
          (use
            (type
              (type_lookup
                (type_reference
                  (name 7:Module1)
                  (type_args
                    (type
                      (type_lookup
                        (type_reference
                          (name 7:Module3)
                          (type_args))))))
                (type_reference
                  (name 3:Foo)
                  (type_args))
                (type_reference
                  (name 3:Bar)
                  (type_args)))))
          (use
            (type
              (type_lookup
                (type_reference
                  (name 3:Int)
                  (type_args))))))))))
