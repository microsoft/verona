# Example of binding

module Module2[T2]
  type Bar = T2

module Module1[T1]
  use Module2[T1]
  type Foo = Bar

module Module3
  struct Int

module Test
  # This brings inc into scope.
  use Module1[Module3]::Foo
  ##  Reduces to 
  ##  Module1[Module3]:::Bar
  ##  Reduces to 
  ##  Module2[Module3]::Bar
  ##  Reduces to
  ##  Module3
  ##  So Int is now in scope.

  use Int

