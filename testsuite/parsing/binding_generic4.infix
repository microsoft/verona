# Example of binding

module Module1[T1]
  module Module2
    type Bar = T1
  type Foo = Module2

module Module3
  struct Int

module Test
  # This brings inc into scope.
  use Module1[Module3]::Foo::Bar
  ##  Reduces to 
  ##  Module1[Module3]::Module2::Bar
  ##  Reduces to 
  ##  Module3
  ##  So Int is now in scope.

  use Int
