infix
resolve_types
(top
  {
    Bool = type_alias
    False = struct
    True = struct}
  (file
    (struct
      {}
      (name 4:True)
      (type_params)
      (fields))
    (struct
      {}
      (name 5:False)
      (type_params)
      (fields))
    (type_alias
      {}
      (name 4:Bool)
      (type_params)
      (type
        (type_or
          (type_lookup
            (../)
            (type_reference
              (name 4:True)
              (type_args)))
          (type_lookup
            (../)
            (type_reference
              (name 5:False)
              (type_args))))))))
