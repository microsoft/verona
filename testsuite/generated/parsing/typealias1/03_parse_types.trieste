infix
parse_types
(top
  {
    Bool = type_alias
    False = struct
    True = struct}
  (file
    (struct
      {}
      (bname 4:True)
      (type_params)
      (fields))
    (struct
      {}
      (bname 5:False)
      (type_params)
      (fields))
    (type_alias
      {}
      (bname 4:Bool)
      (type_params)
      (type
        (lookup
          (reference
            (name 4:True)
            (type_args)))
        (type_or)
        (lookup
          (reference
            (name 5:False)
            (type_args)))))))
