infix
parse_types
(top
  {
    None = struct
    Option = type_alias
    Some = struct}
  (file
    (struct
      {}
      (bname 4:None)
      (type_params)
      (fields))
    (struct
      {
        P = type_param
        value = field}
      (bname 4:Some)
      (type_params
        (type_param
          (bname 1:P)))
      (fields
        (field
          (bname 5:value)
          (type
            (lookup
              (reference
                (name 1:P)
                (type_args)))))))
    (type_alias
      {
        P = type_param}
      (bname 6:Option)
      (type_params
        (type_param
          (bname 1:P)))
      (type
        (lookup
          (reference
            (name 4:None)
            (type_args)))
        (type_or)
        (lookup
          (reference
            (name 4:Some)
            (type_args
              (type
                (lookup
                  (reference
                    (name 1:P)
                    (type_args)))))))))))
