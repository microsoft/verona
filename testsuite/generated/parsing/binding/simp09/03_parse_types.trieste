infix
parse_types
(top
  {
    A = module
    B = module
    C = module}
  (file
    (module
      {
        Foo = module}
      (bname 1:C)
      (type_params)
      (body
        (indent
          (module
            {
              Bar = module}
            (bname 3:Foo)
            (type_params)
            (body
              (indent
                (module
                  {}
                  (bname 3:Bar)
                  (type_params)
                  (body))))))))
    (module
      {
        T2 = type_alias
        T4 = type_alias
        include use B::T1
        include use C}
      (bname 1:A)
      (type_params)
      (body
        (indent
          (use
            (type
              (lookup
                (reference
                  (name 1:B)
                  (type_args))
                (reference
                  (name 2:T1)
                  (type_args)))))
          (use
            (type
              (lookup
                (reference
                  (name 1:C)
                  (type_args)))))
          (type_alias
            {}
            (bname 2:T2)
            (type_params)
            (type
              (lookup
                (reference
                  (name 3:Foo)
                  (type_args)))))
          (type_alias
            {}
            (bname 2:T4)
            (type_params)
            (type
              (lookup
                (reference
                  (name 3:Bar)
                  (type_args))))))))
    (module
      {
        T1 = type_alias
        T3 = type_alias
        include use A::T2
        include use C}
      (bname 1:B)
      (type_params)
      (body
        (indent
          (use
            (type
              (lookup
                (reference
                  (name 1:A)
                  (type_args))
                (reference
                  (name 2:T2)
                  (type_args)))))
          (use
            (type
              (lookup
                (reference
                  (name 1:C)
                  (type_args)))))
          (type_alias
            {}
            (bname 2:T1)
            (type_params)
            (type
              (lookup
                (reference
                  (name 3:Foo)
                  (type_args)))))
          (type_alias
            {}
            (bname 2:T3)
            (type_params)
            (type
              (lookup
                (reference
                  (name 3:Bar)
                  (type_args))))))))))
