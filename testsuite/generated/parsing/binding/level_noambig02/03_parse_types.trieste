infix
parse_types
(top
  {
    Outer = module}
  (file
    (module
      {
        Item = struct
        Source = module
        Test = module}
      (bname 5:Outer)
      (type_params)
      (body
        (indent
          (struct
            {}
            (bname 4:Item)
            (type_params)
            (fields))
          (module
            {
              Item = struct}
            (bname 6:Source)
            (type_params)
            (body
              (indent
                (struct
                  {}
                  (bname 4:Item)
                  (type_params)
                  (fields)))))
          (module
            {
              Alias = type_alias
              include use Source}
            (bname 4:Test)
            (type_params)
            (body
              (indent
                (use
                  (type
                    (lookup
                      (reference
                        (name 6:Source)
                        (type_args)))))
                (type_alias
                  {}
                  (bname 5:Alias)
                  (type_params)
                  (type
                    (lookup
                      (reference
                        (name 4:Item)
                        (type_args)))))))))))))
