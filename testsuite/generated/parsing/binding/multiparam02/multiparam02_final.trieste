infix
resolve_types
(top
  {
    BoolModule = module
    Container = module
    IntModule = module
    StringModule = module
    Test = module}
  (file
    (module
      {
        Int = struct}
      (name 9:IntModule)
      (type_params)
      (body
        (indent
          (struct
            {}
            (name 3:Int)
            (type_params)
            (fields)))))
    (module
      {
        Bool = struct}
      (name 10:BoolModule)
      (type_params)
      (body
        (indent
          (struct
            {}
            (name 4:Bool)
            (type_params)
            (fields)))))
    (module
      {
        String = struct}
      (name 12:StringModule)
      (type_params)
      (body
        (indent
          (struct
            {}
            (name 6:String)
            (type_params)
            (fields)))))
    (module
      {
        Inner = module
        Left = type_alias
        Right = type_alias
        T = type_param}
      (name 9:Container)
      (type_params
        (type_param
          (name 1:T)))
      (body
        (indent
          (type_alias
            {}
            (name 4:Left)
            (type_params)
            (type
              (type_lookup
                (../)
                (type_reference
                  (name 1:T)
                  (type_args)))))
          (type_alias
            {}
            (name 5:Right)
            (type_params)
            (type
              (type_lookup
                (../)
                (type_reference
                  (name 1:T)
                  (type_args)))))
          (module
            {
              Also = type_alias}
            (name 5:Inner)
            (type_params)
            (body
              (indent
                (type_alias
                  {}
                  (name 4:Also)
                  (type_params)
                  (type
                    (type_lookup
                      (../)
                      (../)
                      (type_reference
                        (name 1:T)
                        (type_args)))))))))))
    (module
      {
        include use Container[IntModule]::Left
        include use Container[BoolModule]::Right
        include use Container[StringModule]::Inner::Also
        include use Int
        include use Bool
        include use String}
      (name 4:Test)
      (type_params)
      (body
        (indent
          (use
            (type
              (type_lookup
                (../)
                (type_reference
                  (name 9:IntModule)
                  (type_args)))))
          (use
            (type
              (type_lookup
                (../)
                (type_reference
                  (name 10:BoolModule)
                  (type_args)))))
          (use
            (type
              (type_lookup
                (../)
                (type_reference
                  (name 12:StringModule)
                  (type_args)))))
          (use
            (type
              (type_lookup
                (../)
                (type_reference
                  (name 9:IntModule)
                  (type_args))
                (type_reference
                  (name 3:Int)
                  (type_args)))))
          (use
            (type
              (type_lookup
                (../)
                (type_reference
                  (name 10:BoolModule)
                  (type_args))
                (type_reference
                  (name 4:Bool)
                  (type_args)))))
          (use
            (type
              (type_lookup
                (../)
                (type_reference
                  (name 12:StringModule)
                  (type_args))
                (type_reference
                  (name 6:String)
                  (type_args))))))))))
