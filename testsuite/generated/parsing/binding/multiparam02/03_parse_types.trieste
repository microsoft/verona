infix
parse_types
(top
  {
    BoolModule = module
    Container = module
    IntModule = module
    StringModule = module
    Test = module}
  (file
    (module
      {
        Int = struct}
      (bname 9:IntModule)
      (type_params)
      (body
        (indent
          (struct
            {}
            (bname 3:Int)
            (type_params)
            (fields)))))
    (module
      {
        Bool = struct}
      (bname 10:BoolModule)
      (type_params)
      (body
        (indent
          (struct
            {}
            (bname 4:Bool)
            (type_params)
            (fields)))))
    (module
      {
        String = struct}
      (bname 12:StringModule)
      (type_params)
      (body
        (indent
          (struct
            {}
            (bname 6:String)
            (type_params)
            (fields)))))
    (module
      {
        Inner = module
        Left = type_alias
        Right = type_alias
        T = type_param}
      (bname 9:Container)
      (type_params
        (type_param
          (bname 1:T)))
      (body
        (indent
          (type_alias
            {}
            (bname 4:Left)
            (type_params)
            (type
              (lookup
                (reference
                  (name 1:T)
                  (type_args)))))
          (type_alias
            {}
            (bname 5:Right)
            (type_params)
            (type
              (lookup
                (reference
                  (name 1:T)
                  (type_args)))))
          (module
            {
              Also = type_alias}
            (bname 5:Inner)
            (type_params)
            (body
              (indent
                (type_alias
                  {}
                  (bname 4:Also)
                  (type_params)
                  (type
                    (lookup
                      (reference
                        (name 1:T)
                        (type_args)))))))))))
    (module
      {
        include use Container[IntModule]::Left
        include use Container[BoolModule]::Right
        include use Container[StringModule]::Inner::Also
        include use Int
        include use Bool
        include use String}
      (bname 4:Test)
      (type_params)
      (body
        (indent
          (use
            (type
              (lookup
                (reference
                  (name 9:Container)
                  (type_args
                    (type
                      (lookup
                        (reference
                          (name 9:IntModule)
                          (type_args))))))
                (reference
                  (name 4:Left)
                  (type_args)))))
          (use
            (type
              (lookup
                (reference
                  (name 9:Container)
                  (type_args
                    (type
                      (lookup
                        (reference
                          (name 10:BoolModule)
                          (type_args))))))
                (reference
                  (name 5:Right)
                  (type_args)))))
          (use
            (type
              (lookup
                (reference
                  (name 9:Container)
                  (type_args
                    (type
                      (lookup
                        (reference
                          (name 12:StringModule)
                          (type_args))))))
                (reference
                  (name 5:Inner)
                  (type_args))
                (reference
                  (name 4:Also)
                  (type_args)))))
          (use
            (type
              (lookup
                (reference
                  (name 3:Int)
                  (type_args)))))
          (use
            (type
              (lookup
                (reference
                  (name 4:Bool)
                  (type_args)))))
          (use
            (type
              (lookup
                (reference
                  (name 6:String)
                  (type_args))))))))))
