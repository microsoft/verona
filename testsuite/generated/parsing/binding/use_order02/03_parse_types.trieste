infix
parse_types
(top
  {
    Alias = module
    Source = module
    Test = module}
  (file
    (module
      {
        Target = struct}
      (bname 6:Source)
      (type_params)
      (body
        (indent
          (struct
            {}
            (bname 6:Target)
            (type_params)
            (fields)))))
    (module
      {
        Ref = type_alias
        include use Source}
      (bname 5:Alias)
      (type_params)
      (body
        (indent
          (use
            (type
              (lookup
                (reference
                  (name 6:Source)
                  (type_args)))))
          (type_alias
            {}
            (bname 3:Ref)
            (type_params)
            (type
              (lookup
                (reference
                  (name 6:Target)
                  (type_args))))))))
    (module
      {
        include use Alias::Ref
        include use Target}
      (bname 4:Test)
      (type_params)
      (body
        (indent
          (use
            (type
              (lookup
                (reference
                  (name 5:Alias)
                  (type_args))
                (reference
                  (name 3:Ref)
                  (type_args)))))
          (use
            (type
              (lookup
                (reference
                  (name 6:Target)
                  (type_args))))))))))
