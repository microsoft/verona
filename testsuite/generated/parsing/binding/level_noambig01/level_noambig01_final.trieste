infix
resolve_types
(top
  {
    SourceA = module
    Target = struct
    Test = module}
  (file
    (struct
      {}
      (bname 6:Target)
      (type_params)
      (fields))
    (module
      {
        Target = struct}
      (bname 7:SourceA)
      (type_params)
      (body
        (indent
