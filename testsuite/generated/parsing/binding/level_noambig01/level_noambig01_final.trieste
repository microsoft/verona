                (../)
                (reference
                  (name 7:SourceA)
                  (type_args)))))
          (type_alias
            {}
            (bname 5:Alias)
            (type_params)
            (type
              (lookup
                (../)
                (../)
                (reference
                  (name 7:SourceA)
                  (type_args))
                (reference
                  (name 6:Target)
