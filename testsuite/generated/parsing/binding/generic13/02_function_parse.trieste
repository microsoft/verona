infix
function_parse
(top
  {
    Module1 = module
    Module2 = module
    Test = module}
  (file
    (module
      {
        Int = struct}
      (bname 7:Module1)
      (type_params)
      (body
        (indent
          (struct
            {}
            (bname 3:Int)
            (type_params)
            (fields)))))
    (module
      {
        T = type_param}
      (bname 7:Module2)
      (type_params
        (type_param
          (bname 1:T)))
      (body))
    (module
      {
        include use Module2[Module1]::T
        include use Int}
      (bname 4:Test)
      (type_params)
      (body
        (indent
          (use
            (type
              (name 7:Module2)
              (square
                (group
                  (name 7:Module1)))
              (DoubleColon)
              (name 1:T)))
          (use
            (type
              (name 3:Int))))))))
