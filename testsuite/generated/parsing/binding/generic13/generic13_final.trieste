infix
resolve_types
(top
  {
    Module1 = module
    Module2 = module
    Test = module}
  (file
    (module
      {
        Int = struct}
      (name 7:Module1)
      (type_params)
      (body
        (indent
          (struct
            {}
            (name 3:Int)
            (type_params)
            (fields)))))
    (module
      {
        T = type_param}
      (name 7:Module2)
      (type_params
        (type_param
          (name 1:T)))
      (body))
    (module
      {
        include use Module2[Module1]::T
        include use Int}
      (name 4:Test)
      (type_params)
      (body
        (indent
          (use
            (type
              (type_lookup
                (../)
                (type_reference
                  (name 7:Module1)
                  (type_args)))))
          (use
            (type
              (type_lookup
                (../)
                (type_reference
                  (name 7:Module1)
                  (type_args))
                (type_reference
                  (name 3:Int)
                  (type_args))))))))))
