infix
parse_types
(top
  {
    Module1 = module
    Module2 = module
    Module3 = module
    Test = module}
  (file
    (module
      {
        Foo = type_alias
        T1 = type_param}
      (bname 7:Module1)
      (type_params
        (type_param
          (bname 2:T1)))
      (body
        (indent
          (type_alias
            {}
            (bname 3:Foo)
            (type_params)
            (type
              (lookup
                (reference
                  (name 2:T1)
                  (type_args))))))))
    (module
      {
        Bar = type_alias
        T2 = type_param}
      (bname 7:Module2)
      (type_params
        (type_param
          (bname 2:T2)))
      (body
        (indent
          (type_alias
            {}
            (bname 3:Bar)
            (type_params)
            (type
              (lookup
                (reference
                  (name 2:T2)
                  (type_args))))))))
    (module
      {
        Int = struct}
      (bname 7:Module3)
      (type_params)
      (body
        (indent
          (struct
            {}
            (bname 3:Int)
            (type_params)
            (fields)))))
    (module
      {
        include use Module1[Module2[Module3]]::Foo::Bar
        include use Int}
      (bname 4:Test)
      (type_params)
      (body
        (indent
          (use
            (type
              (lookup
                (reference
                  (name 7:Module1)
                  (type_args
                    (type
                      (lookup
                        (reference
                          (name 7:Module2)
                          (type_args
                            (type
                              (lookup
                                (reference
                                  (name 7:Module3)
                                  (type_args))))))))))
                (reference
                  (name 3:Foo)
                  (type_args))
                (reference
                  (name 3:Bar)
                  (type_args)))))
          (use
            (type
              (lookup
                (reference
                  (name 3:Int)
                  (type_args))))))))))
