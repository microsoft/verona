infix
function_parse
(top
  {
    Base = module
    Left = module
    Right = module
    Top = module}
  (file
    (module
      {
        SharedType = struct}
      (name 4:Base)
      (type_params)
      (body
        (indent
          (struct
            {}
            (name 10:SharedType)
            (type_params)
            (fields)))))
    (module
      {
        LeftAlias = type_alias
        include use Base}
      (name 4:Left)
      (type_params)
      (body
        (indent
          (use
            (type
              (name 4:Base)))
          (type_alias
            {}
            (name 9:LeftAlias)
            (type_params)
            (type
              (name 10:SharedType))))))
    (module
      {
        RightAlias = type_alias
        include use Base}
      (name 5:Right)
      (type_params)
      (body
        (indent
          (use
            (type
              (name 4:Base)))
          (type_alias
            {}
            (name 10:RightAlias)
            (type_params)
            (type
              (name 10:SharedType))))))
    (module
      {
        include use Left
        include use Right
        include use LeftAlias
        include use RightAlias
        include use SharedType}
      (name 3:Top)
      (type_params)
      (body
        (indent
          (use
            (type
              (name 4:Left)))
          (use
            (type
              (name 5:Right)))
          (use
            (type
              (name 9:LeftAlias)))
          (use
            (type
              (name 10:RightAlias)))
          (use
            (type
              (name 10:SharedType))))))))
