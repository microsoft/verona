infix
resolve_types
(top
  {
    SourceA = module
    SourceB = module
    Test = module}
  (file
    (module
      {
        Item = struct}
      (name 7:SourceA)
      (type_params)
      (body
        (indent
          (struct
            {}
            (name 4:Item)
            (type_params)
            (fields)))))
    (module
      {
        Item = struct}
      (name 7:SourceB)
      (type_params)
      (body
        (indent
          (struct
            {}
            (name 4:Item)
            (type_params)
            (fields)))))
    (module
      {
        Alias = type_alias
        Item = struct
        include use SourceA
        include use SourceB}
      (name 4:Test)
      (type_params)
      (body
        (indent
          (struct
            {}
            (name 4:Item)
            (type_params)
            (fields))
          (use
            (type
              (type_lookup
                (../)
                (type_reference
                  (name 7:SourceA)
                  (type_args)))))
          (use
            (type
              (type_lookup
                (../)
                (type_reference
                  (name 7:SourceB)
                  (type_args)))))
          (type_alias
            {}
            (name 5:Alias)
            (type_params)
            (type
              (type_lookup
                (../)
                (type_reference
                  (name 4:Item)
                  (type_args))))))))))
