infix
parse_types
(top
  {
    A = module
    B = module
    C = module}
  (file
    (module
      {
        Foo = module}
      (name 1:C)
      (type_params)
      (body
        (indent
          (module
            {
              Bar = module}
            (name 3:Foo)
            (type_params)
            (body
              (indent
                (module
                  {}
                  (name 3:Bar)
                  (type_params)
                  (body))))))))
    (module
      {
        T2 = type_alias
        T4 = type_alias
        include use C
        include use B::T1}
      (name 1:A)
      (type_params)
      (body
        (indent
          (use
            (type
              (type_lookup
                (type_reference
                  (name 1:C)
                  (type_args)))))
          (type_alias
            {}
            (name 2:T2)
            (type_params)
            (type
              (type_lookup
                (type_reference
                  (name 3:Foo)
                  (type_args)))))
          (use
            (type
              (type_lookup
                (type_reference
                  (name 1:B)
                  (type_args))
                (type_reference
                  (name 2:T1)
                  (type_args)))))
          (type_alias
            {}
            (name 2:T4)
            (type_params)
            (type
              (type_lookup
                (type_reference
                  (name 3:Bar)
                  (type_args))))))))
    (module
      {
        T1 = type_alias
        T3 = type_alias
        include use C
        include use A::T2}
      (name 1:B)
      (type_params)
      (body
        (indent
          (use
            (type
              (type_lookup
                (type_reference
                  (name 1:C)
                  (type_args)))))
          (type_alias
            {}
            (name 2:T1)
            (type_params)
            (type
              (type_lookup
                (type_reference
                  (name 3:Foo)
                  (type_args)))))
          (use
            (type
              (type_lookup
                (type_reference
                  (name 1:A)
                  (type_args))
                (type_reference
                  (name 2:T2)
                  (type_args)))))
          (type_alias
            {}
            (name 2:T3)
            (type_params)
            (type
              (type_lookup
                (type_reference
                  (name 3:Bar)
                  (type_args))))))))))
