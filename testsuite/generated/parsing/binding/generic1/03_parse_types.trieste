infix
parse_types
(top
  {
    Bool = struct
    Int = struct
    Outer = module
    User = module}
  (file
    (struct
      {}
      (bname 3:Int)
      (type_params)
      (fields))
    (struct
      {}
      (bname 4:Bool)
      (type_params)
      (fields))
    (module
      {
        Inner = module
        T1 = type_param}
      (bname 5:Outer)
      (type_params
        (type_param
          (bname 2:T1)))
      (body
        (indent
          (module
            {
              T2 = type_param
              inner_type = type_alias
              outer_type = type_alias}
            (bname 5:Inner)
            (type_params
              (type_param
                (bname 2:T2)))
            (body
              (indent
                (type_alias
                  {}
                  (bname 10:outer_type)
                  (type_params)
                  (type
                    (lookup
                      (reference
                        (name 2:T1)
                        (type_args)))))
                (type_alias
                  {}
                  (bname 10:inner_type)
                  (type_params)
                  (type
                    (lookup
                      (reference
                        (name 2:T2)
                        (type_args)))))))))))
    (module
      {
        include use Outer[Int]::Inner[Bool]::outer_type
        include use Outer[Int]::Inner[Bool]::inner_type}
      (bname 4:User)
      (type_params)
      (body
        (indent
          (use
            (type
              (lookup
                (reference
                  (name 5:Outer)
                  (type_args
                    (type
                      (lookup
                        (reference
                          (name 3:Int)
                          (type_args))))))
                (reference
                  (name 5:Inner)
                  (type_args
                    (type
                      (lookup
                        (reference
                          (name 4:Bool)
                          (type_args))))))
                (reference
                  (name 10:outer_type)
                  (type_args)))))
          (use
            (type
              (lookup
                (reference
                  (name 5:Outer)
                  (type_args
                    (type
                      (lookup
                        (reference
                          (name 3:Int)
                          (type_args))))))
                (reference
                  (name 5:Inner)
                  (type_args
                    (type
                      (lookup
                        (reference
                          (name 4:Bool)
                          (type_args))))))
                (reference
                  (name 10:inner_type)
                  (type_args))))))))))
