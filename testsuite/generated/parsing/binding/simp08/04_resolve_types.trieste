infix
resolve_types
(top
  {
    Module1 = module
    Test = module}
  (file
    (module
      {
        Foo = type_alias
        Module3 = module}
      (bname 7:Module1)
      (type_params)
      (body
        (indent
          (module
            {
              Int = struct}
            (bname 7:Module3)
            (type_params)
            (body
              (indent
                (struct
                  {}
                  (bname 3:Int)
                  (type_params)
                  (fields)))))
          (type_alias
            {}
            (bname 3:Foo)
            (type_params)
            (type
              (lookup
                (../)
                (reference
                  (name 7:Module3)
                  (type_args))))))))
    (module
      {
        include use Module1::Foo
        include use Int}
      (bname 4:Test)
      (type_params)
      (body
        (indent
          (use
            (type
              (lookup
                (../)
                (reference
                  (name 7:Module1)
                  (type_args))
                (reference
                  (name 7:Module3)
                  (type_args)))))
          (use
            (type
              (lookup
                (../)
                (reference
                  (name 7:Module1)
                  (type_args))
                (reference
                  (name 7:Module3)
                  (type_args))
                (reference
                  (name 3:Int)
                  (type_args))))))))))
