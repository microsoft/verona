infix
parse_types
(top
  {
    Container = module
    IntModule = module
    Test = module
    Wrapper = module}
  (file
    (module
      {
        Int = struct}
      (bname 9:IntModule)
      (type_params)
      (body
        (indent
          (struct
            {}
            (bname 3:Int)
            (type_params)
            (fields)))))
    (module
      {
        Inner = type_alias
        T = type_param}
      (bname 7:Wrapper)
      (type_params
        (type_param
          (bname 1:T)))
      (body
        (indent
          (type_alias
            {}
            (bname 5:Inner)
            (type_params)
            (type
              (lookup
                (reference
                  (name 1:T)
                  (type_args))))))))
    (module
      {
        T = type_param
        Wrapped = type_alias}
      (bname 9:Container)
      (type_params
        (type_param
          (bname 1:T)))
      (body
        (indent
          (type_alias
            {}
            (bname 7:Wrapped)
            (type_params)
            (type
              (lookup
                (reference
                  (name 7:Wrapper)
                  (type_args
                    (type
                      (lookup
                        (reference
                          (name 1:T)
                          (type_args))))))))))))
    (module
      {
        include use Container[IntModule]::Wrapped::Inner
        include use Int}
      (bname 4:Test)
      (type_params)
      (body
        (indent
          (use
            (type
              (lookup
                (reference
                  (name 9:Container)
                  (type_args
                    (type
                      (lookup
                        (reference
                          (name 9:IntModule)
                          (type_args))))))
                (reference
                  (name 7:Wrapped)
                  (type_args))
                (reference
                  (name 5:Inner)
                  (type_args)))))
          (use
            (type
              (lookup
                (reference
                  (name 3:Int)
                  (type_args))))))))))
