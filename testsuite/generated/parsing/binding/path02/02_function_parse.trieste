infix
function_parse
(top
  {
    A = module
    Test = module
    X = module
    Y = module}
  (file
    (module
      {
        B = module}
      (bname 1:A)
      (type_params)
      (body
        (indent
          (module
            {
              C = module}
            (bname 1:B)
            (type_params)
            (body
              (indent
                (module
                  {
                    Target = struct}
                  (bname 1:C)
                  (type_params)
                  (body
                    (indent
                      (struct
                        {}
                        (bname 6:Target)
                        (type_params)
                        (fields)))))))))))
    (module
      {
        AliasToB = type_alias}
      (bname 1:X)
      (type_params)
      (body
        (indent
          (type_alias
            {}
            (bname 8:AliasToB)
            (type_params)
            (type
              (name 1:A)
              (DoubleColon)
              (name 1:B))))))
    (module
      {
        AliasToC = type_alias
        include use X}
      (bname 1:Y)
      (type_params)
      (body
        (indent
          (use
            (type
              (name 1:X)))
          (type_alias
            {}
            (bname 8:AliasToC)
            (type_params)
            (type
              (name 8:AliasToB)
              (DoubleColon)
              (name 1:C))))))
    (module
      {
        include use Y::AliasToC
        include use Target}
      (bname 4:Test)
      (type_params)
      (body
        (indent
          (use
            (type
              (name 1:Y)
              (DoubleColon)
              (name 8:AliasToC)))
          (use
            (type
              (name 6:Target))))))))
