infix
parse_types
(top
  {
    Defs = module
    Types = module}
  (file
    (module
      {
        A = struct
        B = struct
        C = struct}
      (bname 5:Types)
      (type_params)
      (body
        (indent
          (struct
            {}
            (bname 1:A)
            (type_params)
            (fields))
          (struct
            {}
            (bname 1:B)
            (type_params)
            (fields))
          (struct
            {}
            (bname 1:C)
            (type_params)
            (fields)))))
    (module
      {
        Choice = type_alias
        include use Types}
      (bname 4:Defs)
      (type_params)
      (body
        (indent
          (use
            (type
              (lookup
                (reference
                  (name 5:Types)
                  (type_args)))))
          (type_alias
            {}
            (bname 6:Choice)
            (type_params)
            (type
              (lookup
                (reference
                  (name 1:A)
                  (type_args)))
              (type_or)
              (lookup
                (reference
                  (name 1:B)
                  (type_args)))
              (type_or)
              (lookup
                (reference
                  (name 1:C)
                  (type_args))))))))))
