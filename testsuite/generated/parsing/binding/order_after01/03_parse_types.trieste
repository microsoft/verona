infix
parse_types
(top
  {
    Source = module
    Test = module}
  (file
    (module
      {
        Target = struct}
      (bname 6:Source)
      (type_params)
      (body
        (indent
          (struct
            {}
            (bname 6:Target)
            (type_params)
            (fields)))))
    (module
      {
        Foo = type_alias
        include use Source}
      (bname 4:Test)
      (type_params)
      (body
        (indent
          (type_alias
            {}
            (bname 3:Foo)
            (type_params)
            (type
              (lookup
                (reference
                  (name 6:Target)
                  (type_args)))))
          (use
            (type
              (lookup
                (reference
                  (name 6:Source)
                  (type_args))))))))))
