infix
parse_types
(top
  {
    Main = module
    Module3 = module
    Test = module
    include use Main[Module3}
  (file
    (module
      {}
      (name 7:Module3)
      (type_params)
      (body))
    (module
      {
        Foo = type_alias
        T1 = type_param}
      (name 4:Main)
      (type_params
        (type_param
          (name 2:T1)))
      (body
        (indent
          (type_alias
            {}
            (name 3:Foo)
            (type_params)
            (type
              (type_lookup
                (type_reference
                  (name 2:T1)
                  (type_args))))))))
    (use
      (type
        (type_lookup
          (type_reference
            (name 4:Main)
            (type_args
              (type
                (type_lookup
                  (type_reference
                    (name 7:Module3)
                    (type_args)))))))))
    (module
      {
        include use Foo}
      (name 4:Test)
      (type_params)
      (body
        (indent
          (use
            (type
              (type_lookup
                (type_reference
                  (name 3:Foo)
                  (type_args))))))))))
