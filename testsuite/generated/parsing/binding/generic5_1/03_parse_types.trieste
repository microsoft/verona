infix
parse_types
(top
  {
    Main = module
    Module3 = module
    Test = module
    include use Main[Module3}
  (file
    (module
      {}
      (bname 7:Module3)
      (type_params)
      (body))
    (module
      {
        Foo = type_alias
        T1 = type_param}
      (bname 4:Main)
      (type_params
        (type_param
          (bname 2:T1)))
      (body
        (indent
          (type_alias
            {}
            (bname 3:Foo)
            (type_params)
            (type
              (lookup
                (reference
                  (name 2:T1)
                  (type_args))))))))
    (use
      (type
        (lookup
          (reference
            (name 4:Main)
            (type_args
              (type
                (lookup
                  (reference
                    (name 7:Module3)
                    (type_args)))))))))
    (module
      {
        include use Foo}
      (bname 4:Test)
      (type_params)
      (body
        (indent
          (use
            (type
              (lookup
                (reference
                  (name 3:Foo)
                  (type_args))))))))))
