infix
parse_types
(top
  {
    SourceA = module
    SourceB = module
    Test = module}
  (file
    (module
      {
        Conflict = struct}
      (bname 7:SourceA)
      (type_params)
      (body
        (indent
          (struct
            {}
            (bname 8:Conflict)
            (type_params)
            (fields)))))
    (module
      {
        Conflict = struct}
      (bname 7:SourceB)
      (type_params)
      (body
        (indent
          (struct
            {}
            (bname 8:Conflict)
            (type_params)
            (fields)))))
    (module
      {
        Alias = type_alias
        include use SourceA
        include use SourceB}
      (bname 4:Test)
      (type_params)
      (body
        (indent
          (use
            (type
              (lookup
                (reference
                  (name 7:SourceA)
                  (type_args)))))
          (use
            (type
              (lookup
                (reference
                  (name 7:SourceB)
                  (type_args)))))
          (type_alias
            {}
            (bname 5:Alias)
            (type_params)
            (type
              (lookup
                (reference
                  (name 8:Conflict)
                  (type_args))))))))))
