infix
parse_types
(top
  {
    Defs = module
    Test = module}
  (file
    (module
      {
        A = struct
        Sub = module}
      (name 4:Defs)
      (type_params)
      (body
        (indent
          (struct
            {}
            (name 1:A)
            (type_params)
            (fields))
          (module
            {
              B = struct}
            (name 3:Sub)
            (type_params)
            (body
              (indent
                (struct
                  {}
                  (name 1:B)
                  (type_params)
                  (fields))))))))
    (module
      {
        include use Defs
        include use Sub
        include use A
        include use B}
      (name 4:Test)
      (type_params)
      (body
        (indent
          (use
            (type
              (type_lookup
                (type_reference
                  (name 4:Defs)
                  (type_args)))))
          (use
            (type
              (type_lookup
                (type_reference
                  (name 3:Sub)
                  (type_args)))))
          (use
            (type
              (type_lookup
                (type_reference
                  (name 1:A)
                  (type_args)))))
          (use
            (type
              (type_lookup
                (type_reference
                  (name 1:B)
                  (type_args))))))))))
