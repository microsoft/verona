infix
resolve_types
(top
  {
    Bool = type_alias
    False = struct
    None = struct
    Some = struct
    True = struct
    else =
      function
      function}
  (file
    (struct
      {}
      (name 4:True)
      (type_params)
      (fields))
    (struct
      {}
      (name 5:False)
      (type_params)
      (fields))
    (type_alias
      {}
      (name 4:Bool)
      (type_params)
      (type
        (type_or
          (type_lookup
            (../)
            (type_reference
              (name 4:True)
              (type_args)))
          (type_lookup
            (../)
            (type_reference
              (name 5:False)
              (type_args))))))
    (struct
      {}
      (name 4:None)
      (type_params)
      (fields))
    (struct
      {
        P = type_param
        value = field}
      (name 4:Some)
      (type_params
        (type_param
          (name 1:P)))
      (fields
        (field
          (name 5:value)
          (type
            (type_lookup
              (type_reference
                (name 1:P)
                (type_args)))))))
    (function
      {
        P = type_param
        lhs = param
        value = param}
      (type_params
        (type_param
          (name 1:P)))
      (lhs
        (param
          (name 3:lhs)
          (mode
            (cbv))
          (type
            (type_lookup
              (../)
              (type_reference
                (name 4:Some)
                (type_args
                  (type
                    (type_lookup
                      (type_reference
                        (name 1:P)
                        (type_args))))))))))
      (name 4:else)
      (rhs
        (param
          (name 5:value)
          (mode
            (cbn))
          (type
            (type_lookup
              (type_reference
                (name 1:P)
                (type_args))))))
      (type
        (type_lookup
          (type_reference
            (name 1:P)
            (type_args))))
      (where)
      (body
        (expr_stack)
        (lookup
          (name 5:value)
          (args
            (name 3:lhs)))))
    (function
      {
        P = type_param
        lhs = param
        value = param}
      (type_params
        (type_param
          (name 1:P)))
      (lhs
        (param
          (name 3:lhs)
          (mode
            (cbv))
          (type
            (type_lookup
              (../)
              (type_reference
                (name 4:None)
                (type_args))))))
      (name 4:else)
      (rhs
        (param
          (name 5:value)
          (mode
            (cbn))
          (type
            (type_lookup
              (type_reference
                (name 1:P)
                (type_args))))))
      (type
        (type_lookup
          (type_reference
            (name 1:P)
            (type_args))))
      (where)
      (body
        (expr_stack)
        (name 5:value)))))
