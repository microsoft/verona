infix
parse_types
(top
  {
    Bool = type_alias
    False = struct
    None = struct
    Some = struct
    True = struct
    else =
      function
      function}
  (file
    (struct
      {}
      (bname 4:True)
      (type_params)
      (fields))
    (struct
      {}
      (bname 5:False)
      (type_params)
      (fields))
    (type_alias
      {}
      (bname 4:Bool)
      (type_params)
      (type
        (lookup
          (reference
            (name 4:True)
            (type_args)))
        (type_or)
        (lookup
          (reference
            (name 5:False)
            (type_args)))))
    (struct
      {}
      (bname 4:None)
      (type_params)
      (fields))
    (struct
      {
        P = type_param
        value = field}
      (bname 4:Some)
      (type_params
        (type_param
          (bname 1:P)))
      (fields
        (field
          (bname 5:value)
          (type
            (lookup
              (reference
                (name 1:P)
                (type_args)))))))
    (function
      {
        P = type_param
        lhs = param
        value = param}
      (type_params
        (type_param
          (bname 1:P)))
      (lhs
        (param
          (bname 3:lhs)
          (mode
            (cbv))
          (type
            (lookup
              (reference
                (name 4:Some)
                (type_args
                  (type
                    (lookup
                      (reference
                        (name 1:P)
                        (type_args))))))))))
      (bname 4:else)
      (rhs
        (param
          (bname 5:value)
          (mode
            (cbn))
          (type
            (lookup
              (reference
                (name 1:P)
                (type_args))))))
      (type
        (lookup
          (reference
            (name 1:P)
            (type_args))))
      (where)
      (body
        (expr_stack)
        (access
          (bname 5:value)
          (args
            (lookup
              (reference
                (name 3:lhs)
                (type_args)))))))
    (function
      {
        P = type_param
        lhs = param
        value = param}
      (type_params
        (type_param
          (bname 1:P)))
      (lhs
        (param
          (bname 3:lhs)
          (mode
            (cbv))
          (type
            (lookup
              (reference
                (name 4:None)
                (type_args))))))
      (bname 4:else)
      (rhs
        (param
          (bname 5:value)
          (mode
            (cbn))
          (type
            (lookup
              (reference
                (name 1:P)
                (type_args))))))
      (type
        (lookup
          (reference
            (name 1:P)
            (type_args))))
      (where)
      (body
        (expr_stack)
        (lookup
          (reference
            (name 5:value)
            (type_args)))))))
